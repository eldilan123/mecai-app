# ============================================================
# MecAI — Variables de entorno (plantilla)
# ============================================================
# Copia este archivo a `.env` y reemplaza los placeholders.
# NUNCA commitees `.env` con valores reales (está en .gitignore).
#
# Las variables EXPO_PUBLIC_* se incluyen en el bundle de la app:
# solo deben contener claves PÚBLICAS. Las claves secretas (Claude,
# service role, FCM) van EXCLUSIVAMENTE en Supabase Edge Functions.
# ============================================================

# --- Supabase (públicas — van en el bundle de la app) ---
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- RevenueCat (públicas) ---
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_xxxxx
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_xxxxx

# --- AdMob (públicas) ---
EXPO_PUBLIC_ADMOB_ANDROID_ID=ca-app-pub-xxxxx~xxxxx
EXPO_PUBLIC_ADMOB_IOS_ID=ca-app-pub-xxxxx~xxxxx

# ============================================================
# SOLO EN SUPABASE EDGE FUNCTIONS (server-side, NUNCA en la app)
# Estas NO se prefijan con EXPO_PUBLIC_ y no deben terminar en el bundle.
# Se configuran como secrets en Supabase (HU-04), no en este .env del cliente.
# ============================================================
CLAUDE_API_KEY=sk-ant-xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
FCM_SERVER_KEY=xxxxx

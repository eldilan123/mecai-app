# ============================================================
# MecAI — Variables de entorno (plantilla)
# ============================================================
# Copia este archivo a `.env` y reemplaza los placeholders.
# NUNCA commitees `.env` con valores reales (está en .gitignore).
#
# Las variables EXPO_PUBLIC_* se incluyen en el bundle de la app:
# solo deben contener claves PÚBLICAS. Las claves secretas (Claude,
# service role, FCM, DB password) van EXCLUSIVAMENTE server-side.
# ============================================================

# --- Supabase (públicas — van en el bundle de la app) ---
# Dónde: Supabase Dashboard → Project Settings → Data API / API Keys.
#   URL       = "Project URL"
#   ANON_KEY  = "anon public" key
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- RevenueCat (públicas) — HU-05/HU-15 ---
# Dónde: RevenueCat Dashboard → Project → API Keys (una por plataforma).
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_xxxxx
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_xxxxx

# --- AdMob (públicas) — HU-05/HU-15 ---
# Dónde: AdMob → App settings → App ID (formato ca-app-pub-XXXX~YYYY).
EXPO_PUBLIC_ADMOB_ANDROID_ID=ca-app-pub-xxxxx~xxxxx
EXPO_PUBLIC_ADMOB_IOS_ID=ca-app-pub-xxxxx~xxxxx

# ============================================================
# SOLO SERVER-SIDE — NUNCA en el bundle de la app.
# Se configuran como SECRETS en Supabase Edge Functions:
#   npx supabase secrets set NOMBRE=valor
# NO se prefijan con EXPO_PUBLIC_.
# ============================================================
# Claude API key — pendiente de HU-05 (por ahora placeholder).
#   Dónde: console.anthropic.com → API Keys.
CLAUDE_API_KEY=sk-ant-xxxxx
# service_role key — Supabase Dashboard → Project Settings → API Keys → "service_role".
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# FCM server key — Firebase Console → Project settings → Cloud Messaging (HU-13).
FCM_SERVER_KEY=xxxxx

# ============================================================
# SOLO PARA EL SUPABASE CLI (migraciones / gen types) — NO son del runtime de la app.
# No se commitean con valores reales.
# ============================================================
# Dónde: Supabase Dashboard → Project Settings → General ("Reference ID")
#        y Database → Connection string (password que definiste al crear el proyecto).
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=your-db-password
# Personal Access Token para `supabase link` / `functions deploy` / `secrets set`.
#   Dónde: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxx
